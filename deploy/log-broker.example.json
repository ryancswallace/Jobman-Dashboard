      "expectedInstanceId": "22222222-2222-4222-8222-222222222222",
      "namespaceIds": [
        "33333333-3333-4333-8333-333333333333"
      ],
      "trustRootsFile": "/etc/jobman-log-broker/tls/control-roots.pem",
      "clientCertificateFile": "/etc/jobman-log-broker/tls/control-client.pem",
