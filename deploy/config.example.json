{
  "configurationRevision": 1,
  "publicOrigin": "https://dashboard.example.internal",
  "listen": "0.0.0.0:8443",
  "webRoot": "/opt/jobman-dashboard/web",
  "serverTLS": {
    "certificateFile": "/etc/jobman-dashboard/tls/server.pem",
    "keyFile": "/run/secrets/dashboard-server-key.pem"
  },
  "databaseURLFile": "/run/secrets/dashboard-database-url",
  "oidc": {
    "issuer": "https://adfs.example.internal/adfs",
    "apiAudience": "REPLACE_WITH_DASHBOARD_API_AUDIENCE",
    "webClientId": "REPLACE_WITH_CONFIDENTIAL_WEB_CLIENT_ID",
    "webClientSecretFile": "/run/secrets/dashboard-web-client-secret",
    "nativeClientId": "REPLACE_WITH_PUBLIC_NATIVE_CLIENT_ID",
    "nativeRedirectURI": "jobman-dashboard-auth://callback",
    "scopes": [
      "openid",
      "profile",
      "offline_access"
    ],
    "directoryIdClaim": "REPLACE_WITH_VERIFIED_DIRECTORY_GUID_CLAIM",
    "clientIdClaim": "REPLACE_WITH_VERIFIED_CLIENT_ID_CLAIM",
    "trustRootsFile": "/etc/jobman-dashboard/tls/adfs-roots.pem"
  },
  "encryption": {
    "keyFile": "/run/secrets/dashboard-encryption-key",
    "keyId": "dashboard-key-1"
  },
  "controls": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "REPLACE_WITH_SOURCE_NAME",
      "origin": "https://control.example.internal",
      "expectedInstanceId": "22222222-2222-4222-8222-222222222222",
      "namespaceIds": [
        "33333333-3333-4333-8333-333333333333"
      ],
      "trustRootsFile": "/etc/jobman-dashboard/tls/control-roots.pem",
      "clientCertificateFile": "/etc/jobman-dashboard/tls/control-client.pem",
      "clientKeyFile": "/run/secrets/dashboard-control-client-key.pem",
      "delegationKeyFile": "/run/secrets/dashboard-control-delegation-key.pem",
      "delegationKeyId": "dashboard-control-key-1",
      "serviceId": "REPLACE_WITH_REGISTERED_DASHBOARD_SERVICE_ID",
      "audience": "REPLACE_WITH_REGISTERED_CONTROL_AUDIENCE"
    }
  ],
  "logBrokers": [
    {
      "id": "shared-nfs",
      "deploymentId": "11111111-1111-4111-8111-111111111111",
      "origin": "https://log-broker.example.internal:9443",
      "namespaceIds": [
        "33333333-3333-4333-8333-333333333333"
      ],
      "trustRootsFile": "/etc/jobman-dashboard/tls/broker-roots.pem",
      "clientCertificateFile": "/etc/jobman-dashboard/tls/broker-client.pem",
      "clientKeyFile": "/run/secrets/dashboard-broker-client-key.pem",
      "delegationKeyFile": "/run/secrets/dashboard-broker-delegation-key.pem",
      "delegationKeyId": "dashboard-broker-key-1",
      "serviceId": "REPLACE_WITH_REGISTERED_DASHBOARD_BROKER_SERVICE_ID",
      "audience": "REPLACE_WITH_REGISTERED_BROKER_AUDIENCE"
    }
  ],
  "logMappings": [
    {
      "brokerId": "shared-nfs",
      "deploymentId": "11111111-1111-4111-8111-111111111111",
      "targetGenerationId": "",
      "storeName": "replace-with-store-name",
      "storeVersion": "1"
    }
  ]
}
